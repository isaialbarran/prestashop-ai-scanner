{
  "name": "prestashop-ai-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:setup": "tsx --env-file-if-exists=.env.local scripts/check-setup.ts",
    "batch": "tsx --env-file-if-exists=.env.local scripts/batch.ts",
    "validate": "tsx --env-file-if-exists=.env.local scripts/validate-domains.ts",
    "report": "tsx --env-file-if-exists=.env.local scripts/report.ts",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:prepare": "tsx --env-file-if-exists=.env.local scripts/eval-prepare.ts",
    "eval:import": "tsx --env-file-if-exists=.env.local scripts/eval-import.ts",
    "label": "tsx --env-file-if-exists=.env.local scripts/label.ts"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cheerio": "^1.2.0",
    "next": "16.4.0",
    "openai": "^7.30.1",
    "p-limit": "^7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "domhandler": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
