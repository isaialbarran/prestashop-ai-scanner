# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local.

# Proveedores LLM para el test de visibilidad (fase 2)
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
# Gemini no se usa hasta revisar los términos de Grounding with Google Search
GEMINI_API_KEY=

# Supabase (resultados y evals)
SUPABASE_URL=
# Clave secreta (sb_secret_...). Las claves legacy service_role dejan de funcionar a finales de 2026.
SUPABASE_SECRET_KEY=

# Core Web Vitals de campo (check E2)
PAGESPEED_API_KEY=

# Presupuesto: el lote se detiene al superar este importe
MAX_BATCH_EUR=20
